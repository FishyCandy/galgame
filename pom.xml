        </dependency>

        <dependency>
            <groupId>com.adonax</groupId>
            <artifactId>audiocue</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- JavaFX 核心模块 -->
        <dependency>
            <groupId>org.openjfx</groupId>
